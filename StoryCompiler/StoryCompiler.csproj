<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>LSTools.StoryCompiler</RootNamespace>

		<LangVersion>14</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<AssemblyTitle>Osiris Story Compiler</AssemblyTitle>
		<Product>LSLib</Product>
		<Copyright>Copyright © Norbyte 2012-2018</Copyright>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>

		<PublishAot>true</PublishAot>
		<IsTrimmable>true</IsTrimmable>
		<TrimMode>full</TrimMode>
		<OptimizationPreference>Speed</OptimizationPreference>
		<IlcGenerateCompleteTypeMetadata>false</IlcGenerateCompleteTypeMetadata>
		<IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
		
		<PublishTrimmed>true</PublishTrimmed>
		<ComVisible>false</ComVisible>
		<Guid>32f08b9a-f50b-4c2e-ab56-533fed066dde</Guid>
		<PlatformTarget>x64</PlatformTarget>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\LSLib\LSLib.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="LightProto" Version="1.3.2" />
		<PackageReference Include="System.CommandLine" Version="2.0.8" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>LSTools.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
	
</Project>